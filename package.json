{
  "name": "hello-mq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "消息队列、事件流平台与可靠消息模式知识库（Message Queue & Event Streaming Explorer）",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
